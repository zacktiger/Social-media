# Copy to .env before running the API:  cp .env.example .env

NODE_ENV=development
PORT=4000

# Matches docker-compose.yml
DATABASE_URL="postgresql://pulse:pulse@localhost:5432/pulse?schema=public"
REDIS_URL="redis://localhost:6379"

# Generate a real secret for anything you deploy:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Only the access token is a JWT. Refresh tokens are opaque random strings
# stored hashed in Postgres, so they can be revoked server-side.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# Where the web app runs (used for CORS + refresh cookie)
WEB_ORIGIN="http://localhost:3000"

# true  -> the API process also runs the fan-out worker (one terminal, easiest)
# false -> run `npm run dev:worker` separately, which is how it deploys
INLINE_WORKER=true

# --- Media -----------------------------------------------------------------
# local -> resized images are written to apps/api/uploads and served by this
#          API at /uploads (no cloud account needed)
# s3    -> pushed to an S3-compatible bucket and served from your CDN.
#          Requires: npm install @aws-sdk/client-s3 -w @pulse/api
STORAGE=local
UPLOAD_DIR=uploads
PUBLIC_API_URL="http://localhost:4000"
# S3_BUCKET=""
# S3_REGION="us-east-1"
# S3_PUBLIC_URL="https://cdn.example.com"

# --- Rate limiting ---------------------------------------------------------
# Scales every budget (post 10/min, like 60/min, login 10/15min, ...).
# Keep at 1. Raise it only for a load test, which hammers one IP and would
# otherwise just be measuring the rate limiter:
#   RATE_LIMIT_MULTIPLIER=1000 npm run dev:api
RATE_LIMIT_MULTIPLIER=1

# --- Feed tuning -----------------------------------------------------------
# Authors with more followers than this are never fanned out on write; their
# posts are pulled at read time instead. Lower it to see the celebrity path
# kick in on a small dataset.
FANOUT_THRESHOLD=5000
# How many post ids to keep in each user's Redis feed ZSET.
FEED_MAX_LENGTH=800
# How many posts a single fan-out job writes per Redis pipeline batch.
FANOUT_BATCH_SIZE=500
